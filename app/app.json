{
  "expo": {
    "name": "Forage Around",
    "slug": "forage-around",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "foragearound",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F1E7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foragearound.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Forage Around uses your location to show edible fruit, herbs and greens growing near you that are in season right now."
      }
    },
    "android": {
      "package": "com.foragearound.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Forage Around uses your location to show edible plants growing near you that are in season."
        }
      ],
      "expo-font"
    ]
  }
}
